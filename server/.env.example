# =========================================================
# NEOLIGHT — variables de entorno del servidor
# Copiar a .env y ajustar para cada entorno de despliegue
# =========================================================

# Puerto del servidor Express
PORT=3000

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=lampara

# CORS — origen permitido (* para desarrollo)
CORS_ORIGIN=*

# Código de acceso hospitalario (6 dígitos)
HOSPITAL_CODE=152436

# URL del stream MJPEG de la cámara ESP32-S3
# El servidor se anuncia en la red como http://neolight.local:3000
# Cuando usás el AP del ESP32 (WiFi: NEOLIGHT), la IP del maestro
# siempre es 192.168.4.1 — usá esa IP para el stream de la cámara.
CAM_STREAM_URL=http://192.168.4.1/stream
