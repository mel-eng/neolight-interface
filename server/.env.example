# =========================================================
# NEOLIGHT — variables de entorno del servidor
# Copiar a .env y ajustar para cada entorno de despliegue
# =========================================================

# Puerto del servidor Express
PORT=3000

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=lampara

# CORS — origen permitido (* para desarrollo)
CORS_ORIGIN=*

# Código de acceso hospitalario (6 dígitos)
HOSPITAL_CODE=152436

# URL del stream MJPEG de la cámara ESP32-S3
# Formato: http://<IP_del_ESP32>/stream
# En producción: reemplazar con la IP estática asignada al dispositivo
# En desarrollo local: usar la IP de la red WiFi donde está el ESP32
CAM_STREAM_URL=http://10.26.0.74/stream
